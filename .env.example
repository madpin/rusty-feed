# RustSS example environment.
# Copy to `.env` and fill in. Config is typed and validated at startup (M1);
# the process refuses to boot on invalid/missing required values.
# Full reference: docs/CONFIGURATION.md.
# Optional alternative: set RUSTSS_CONFIG_FILE to a TOML file. Environment and
# .env values override the file. Compose-only variables remain environment-only.
# RUSTSS_CONFIG_FILE=/etc/rustss/config.toml

# ── Server ───────────────────────────────────────────────────────────────────
BIND_ADDR=0.0.0.0:8080
APP_PORT=8080                    # Docker Compose host port only
APP_BIND_IP=0.0.0.0              # use 127.0.0.1 when a TLS proxy owns :80/:443
BASE_URL=http://localhost:8080
LOG_LEVEL=info                 # tracing EnvFilter, e.g. info | debug | rustss=debug
SYSTEMD_NOTIFY_ENABLED=true    # auto-detect NOTIFY_SOCKET; READY/STOPPING/watchdog
PWA_NAME=RustSS                # installed app name (1..64 printable characters)
PWA_SHORT_NAME=RustSS          # home-screen label (1..32 printable characters)
PWA_THEME_COLOR="#2563eb"      # installed window/title-bar color (#RRGGBB)
PWA_BACKGROUND_COLOR="#f8fafc" # launch background color (#RRGGBB)
EXTERNAL_LINKS_NEW_TAB_REQUIRED=false # override personal same-tab navigation
PUBLIC_ARTICLE_SHARING_ENABLED=true # allow users to create revocable public links
PUBLIC_SHARE_DEFAULT_LIFETIME_DAYS=30 # default finite share lifetime
PUBLIC_SHARE_MAX_LIFETIME_DAYS=3650   # accepted range: 1..3650
PUBLIC_SHARE_ALLOW_INFINITE=true      # expose an explicit non-expiring option
API_ENABLED=true                     # native /api/v1 automation API
GREADER_API_ENABLED=true             # Google Reader-compatible client API
FEVER_API_ENABLED=true               # Fever-compatible JSON client API
CUSTOM_CSS_ENABLED=true              # personal, versioned stylesheets
CUSTOM_JAVASCRIPT_ENABLED=false      # admin-managed external script; explicit opt-in
UI_CUSTOMIZATION_MAX_BYTES=65536     # 1024..262144 bytes per version
PASSKEYS_ENABLED=false               # pure HTTPS BASE_URL origin; loopback HTTP only in development
PASSKEY_RP_NAME=RustSS               # 1..64 printable characters
# Optional bundled Caddy profiles: https-auto or https-custom (choose one).
# RUSTSS_DOMAIN=reader.example.com
# TLS_EMAIL=admin@example.com          # automatic ACME/Let's Encrypt profile
# TLS_CERT_DIR=../certs                # custom profile host directory
# TLS_CERT_FILE=cert.pem
# TLS_KEY_FILE=key.pem

# ── Database (required) ──────────────────────────────────────────────────────
# Host port published by Docker Compose. Keep DATABASE_URL's port in sync when
# running RustSS or database tools directly on the host.
POSTGRES_PORT=5432
DATABASE_URL=postgres://rustss:rustss@localhost:5432/rustss
AUTO_MIGRATE=true              # Compose entrypoint applies migrations before boot

# ── Cache / Redis ────────────────────────────────────────────────────────────
# Redis is optional. Set CACHE_ENABLED=false and omit REDIS_URL for the
# in-process L1 cache only.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=
CACHE_ENABLED=true
CACHE_NAMESPACE=rustss           # isolate L2 keys/pub-sub when Redis is shared

# ── Auth & sessions (required secrets) ───────────────────────────────────────
# Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-32-bytes-min
REGISTRATION_MODE=open         # open | invite | closed; first user becomes admin
# Trusted reverse-proxy identity is disabled unless all trust boundaries are explicit.
REVERSE_PROXY_AUTH_ENABLED=false
REVERSE_PROXY_AUTH_TRUSTED_CIDRS=127.0.0.1/32,::1/128
REVERSE_PROXY_AUTH_USER_HEADER=x-remote-user
REVERSE_PROXY_AUTH_NAME_HEADER=x-remote-name
REVERSE_PROXY_AUTH_AUTO_PROVISION=true
# REVERSE_PROXY_AUTH_ALLOWED_DOMAINS=example.com,company.example
# REVERSE_PROXY_AUTH_ADMIN_EMAILS=admin@example.com
# REVERSE_PROXY_AUTH_LOGOUT_URL=https://auth.example.com/logout
# OAuth (optional; local accounts work without any of these)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_AUTH_URL=
# OAUTH_TOKEN_URL=
# OAUTH_USERINFO_URL=
# OAUTH_PROVIDER_NAME=OAuth

# ── Secrets encryption (required) ────────────────────────────────────────────
# Master secret for encrypted stored-secret paths. Public page extraction never uses feed cookies. Generate with: openssl rand -base64 48
ENCRYPTION_SECRET=change-me-32-bytes-min

# ── Embeddings (one model per instance) ──────────────────────────────────────
# `local` uses the production BGE fastembed model cached in MODEL_CACHE_DIR;
# `openai` selects a compatible remote embedding endpoint instead.
EMBEDDING_PROVIDER=local       # local | openai
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5 # fixed per instance; changing it requires re-embed
EMBEDDING_BATCH_SIZE=10
EMBEDDING_AUTO_GENERATE=false
MODEL_CACHE_DIR=/var/lib/rustss/models
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # root URL also accepted

# ── Search ──────────────────────────────────────────────────────────────────────
# Users may inherit or override these defaults in Reading preferences.
SEARCH_MODE=hybrid                         # hybrid | keyword | semantic
SEARCH_TEXT_CONFIG=simple                  # simple (multilingual) | english (stemming)
SEARCH_SEMANTIC_WEIGHT_PERCENT=60          # 0..100, contribution in hybrid mode

# ── LLM (summarization; optional) ────────────────────────────────────────────
LLM_PROVIDER=openai            # openai | ollama
LLM_SUMMARY_MODEL=gpt-4o-mini
LLM_DIGEST_MODEL=gpt-4o-mini
LLM_AUTO_SUMMARIZE=false                       # shared background summaries; may incur cost
OLLAMA_BASE_URL=http://localhost:11434

# ── Content extraction ───────────────────────────────────────────────────────
CHROMIUM_ENABLED=true
CHROMIUM_PORT=9222
CHROMIUM_CDP_URL=http://localhost:9222   # remote headless Chrome (compose service)
EXTRACTION_TIMEOUT_MS=30000
EXTRACTION_DELAY_MS=3000        # per-domain base delay
RESPECT_ROBOTS_TXT=true
OUTBOUND_USER_AGENT="RustSS/0.1 (+https://github.com/madpin/rustss)" # 1..256 printable ASCII chars
OUTBOUND_HTTP1_ONLY=false       # true disables HTTP/2 for every publisher request
# SSRF guard: reject feeds/content on private/loopback addresses. Leave false in
# production; set true only for trusted intranet feeds or local testing.
FEEDS_ALLOW_PRIVATE_NETWORK=false

# Remove known analytics query parameters from shared article keys, publisher
# fetches, and rendered content links. Extra entries are exact names or a
# trailing-wildcard prefix; domain exceptions include all subdomains.
TRACKING_URL_CLEANUP_ENABLED=true
TRACKING_URL_EXTRA_PARAMETERS=          # e.g. campaign_id,ref_*
TRACKING_URL_DOMAIN_EXCEPTIONS=         # e.g. signed.example.com,legacy.example.org

# Tracking images are removed locally during shared content processing; no
# remote image probe is made. Allowed hosts override URL/host rules, but never
# explicit tiny or hidden-image detection. Lists accept at most 100 hostnames.
TRACKING_PIXEL_STRICTNESS=balanced       # conservative | balanced | strict
TRACKING_PIXEL_BLOCKED_HOSTS=            # e.g. metrics.example.com,pixels.example.org
TRACKING_PIXEL_ALLOWED_HOSTS=            # e.g. images.metrics.example.com

# Privacy-enhanced YouTube players. Source hosts are validated and bounded;
# the built-in embed uses youtube-nocookie.com and an optional alternative must
# be one administrator-approved credential-free HTTPS origin.
YOUTUBE_EMBEDS_ENABLED=true
YOUTUBE_SOURCE_HOSTS=                    # empty uses youtube.com,youtube-nocookie.com,youtu.be
# Optional Invidious-compatible HTTPS player; configure both values together.
YOUTUBE_ALTERNATIVE_PLAYER_NAME=
YOUTUBE_ALTERNATIVE_PLAYER_URL=
YOUTUBE_DURATION_ENABLED=false             # shared public-page duration enrichment
YOUTUBE_DURATION_DAILY_BUDGET=100           # 1..10000 shared attempts/day
YOUTUBE_DURATION_CACHE_DAYS=30              # 1..365 days

# Shared, article-authorized media proxy. Successful bodies are stored once per
# source URL; values are bounded both per object and across the instance.
MEDIA_PROXY_ENABLED=true
MEDIA_PROXY_MAX_BYTES=67108864                 # 64 MiB per attachment
MEDIA_PROXY_CACHE_BUDGET_BYTES=2147483648      # 2 GiB aggregate body budget
MEDIA_PROXY_CACHE_TTL_SECONDS=604800            # 7 days
MEDIA_PROXY_NEGATIVE_TTL_SECONDS=300            # retry publisher failures after 5 minutes
MEDIA_PROXY_EXTRA_INLINE_MIME_TYPES=             # optional: image/jxl,image/heic,image/heif,audio/3gpp,audio/3gpp2,audio/x-m4a,video/3gpp,video/3gpp2,video/x-m4v

# Shared article rows: 0 keeps them forever. Bookmarks are always preserved.
ARTICLE_RETENTION_DAYS=0
RETENTION_AGE_BASIS=published                   # published | created

# ── Background jobs / AGENTS ──────────────────────────────────────────────────
ENABLE_CRON_JOBS=true           # false keeps queue consumers but disables scheduled work
RUN_EMBEDDED_WORKER=true        # run the AGENTS worker inside the server process
# The scheduler evaluates these UTC cron expressions and still respects each
# feed's persisted health-adjusted next-fetch time.
FEED_REFRESH_SCHEDULE=*/5 * * * *
CLEANUP_SCHEDULE=0 3 * * *
FEED_REFRESH_CONCURRENCY=3      # background queue slots (feed refresh, extraction, bulk work)
INTERACTIVE_JOB_CONCURRENCY=1   # reserved low-latency slots for user-triggered work
SAVED_SEARCH_CONCURRENCY=5      # reserved for per-agent worker pools
JOB_LOCK_TIMEOUT_MS=600000      # reserved for configurable job leases
