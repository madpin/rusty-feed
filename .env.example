# RustSS example environment.
# Copy to `.env` and fill in. Config is typed and validated at startup (M1);
# the process refuses to boot on invalid/missing required values.
# Full reference: docs/ARCHITECTURE.md §16.

# ── Server ───────────────────────────────────────────────────────────────────
BIND_ADDR=0.0.0.0:8080
BASE_URL=http://localhost:8080
LOG_LEVEL=info                 # tracing EnvFilter, e.g. info | debug | rustss=debug

# ── Database (required) ──────────────────────────────────────────────────────
# Host port published by Docker Compose. Keep DATABASE_URL's port in sync when
# running RustSS or database tools directly on the host.
POSTGRES_PORT=5432
DATABASE_URL=postgres://rustss:rustss@localhost:5432/rustss
AUTO_MIGRATE=true              # Compose entrypoint applies migrations before boot

# ── Cache / Redis ────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=
CACHE_ENABLED=true

# ── Auth & sessions (required secrets) ───────────────────────────────────────
# Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-32-bytes-min
REGISTRATION_MODE=open         # open | closed  (`invite` is reserved; first user becomes admin)
# OAuth (optional; local accounts work without any of these)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_AUTH_URL=
# OAUTH_TOKEN_URL=
# OAUTH_USERINFO_URL=
# OAUTH_PROVIDER_NAME=OAuth

# ── Secrets encryption (required) ────────────────────────────────────────────
# Encrypts LLM API keys and feed cookies at rest. Generate with: openssl rand -base64 48
ENCRYPTION_SECRET=change-me-32-bytes-min

# ── Embeddings (one model per instance) ──────────────────────────────────────
# `local` currently uses the deterministic hash-placeholder-v1 development
# embedder; configure `openai` + a real model for semantic embeddings.
EMBEDDING_PROVIDER=local       # local | openai
EMBEDDING_MODEL=hash-placeholder-v1   # fixed per instance; changing it requires re-embed
EMBEDDING_BATCH_SIZE=10
EMBEDDING_AUTO_GENERATE=false
MODEL_CACHE_DIR=/var/lib/rustss/models
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # root URL also accepted

# ── LLM (summarization; optional) ────────────────────────────────────────────
LLM_PROVIDER=openai            # openai | ollama
LLM_SUMMARY_MODEL=gpt-4o-mini
LLM_DIGEST_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434

# ── Content extraction ───────────────────────────────────────────────────────
CHROMIUM_ENABLED=true
CHROMIUM_PORT=9222
CHROMIUM_CDP_URL=http://localhost:9222   # remote headless Chrome (compose service)
EXTRACTION_TIMEOUT_MS=30000
EXTRACTION_DELAY_MS=3000        # per-domain base delay
RESPECT_ROBOTS_TXT=true
# SSRF guard: reject feeds/content on private/loopback addresses. Leave false in
# production; set true only for trusted intranet feeds or local testing.
FEEDS_ALLOW_PRIVATE_NETWORK=false

# ── Background jobs / AGENTS ──────────────────────────────────────────────────
ENABLE_CRON_JOBS=true           # false keeps queue consumers but disables scheduled work
RUN_EMBEDDED_WORKER=true        # run the AGENTS worker inside the server process
# The current scheduler checks due feeds every 60 seconds. Cron schedule values
# are reserved for the planned cron scheduler; per-feed cadence is stored in DB.
FEED_REFRESH_SCHEDULE=*/5 * * * *
CLEANUP_SCHEDULE=0 3 * * *
FEED_REFRESH_CONCURRENCY=3      # currently the shared worker-consumer count
SAVED_SEARCH_CONCURRENCY=5      # reserved for per-agent worker pools
JOB_LOCK_TIMEOUT_MS=600000      # reserved for configurable job leases
