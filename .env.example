# Rusty Feed example environment.
# Copy to `.env` and fill in. Config is typed and validated at startup (M1);
# the process refuses to boot on invalid/missing required values.
# Full reference: docs/CONFIGURATION.md.
# Optional alternative: set RUSTY_FEED_CONFIG_FILE to a TOML file. Environment and
# .env values override the file. Compose-only variables remain environment-only.
# RUSTY_FEED_CONFIG_FILE=/etc/rusty-feed/config.toml

# ── Server ───────────────────────────────────────────────────────────────────
BIND_ADDR=0.0.0.0:8080
APP_PORT=8080                    # Docker Compose host port only
APP_BIND_IP=0.0.0.0              # use 127.0.0.1 when a TLS proxy owns :80/:443
# RUSTY_FEED_IMAGE=ghcr.io/madpin/rusty-feed:main # Dokploy image/tag override
BASE_URL=http://localhost:8080
LOG_LEVEL=info                 # tracing EnvFilter, e.g. info | debug | rusty_feed=debug
SYSTEMD_NOTIFY_ENABLED=true    # auto-detect NOTIFY_SOCKET; READY/STOPPING/watchdog
PWA_NAME=Rusty Feed                # installed app name (1..64 printable characters)
PWA_SHORT_NAME=Rusty Feed          # home-screen label (1..32 printable characters)
PWA_THEME_COLOR="#2563eb"      # installed window/title-bar color (#RRGGBB)
PWA_BACKGROUND_COLOR="#f8fafc" # launch background color (#RRGGBB)
EXTERNAL_LINKS_NEW_TAB_REQUIRED=false # override personal same-tab navigation
PUBLIC_ARTICLE_SHARING_ENABLED=true # allow users to create revocable public links
PUBLIC_SHARE_DEFAULT_LIFETIME_DAYS=30 # default finite share lifetime
PUBLIC_SHARE_MAX_LIFETIME_DAYS=3650   # accepted range: 1..3650
PUBLIC_SHARE_ALLOW_INFINITE=true      # expose an explicit non-expiring option
API_ENABLED=true                     # native /api/v1 automation API
GREADER_API_ENABLED=true             # Google Reader-compatible client API
FEVER_API_ENABLED=true               # Fever-compatible JSON client API
CUSTOM_CSS_ENABLED=true              # personal, versioned stylesheets
CUSTOM_JAVASCRIPT_ENABLED=false      # admin-managed external script; explicit opt-in
UI_CUSTOMIZATION_MAX_BYTES=65536     # 1024..262144 bytes per version
PASSKEYS_ENABLED=false               # pure HTTPS BASE_URL origin; loopback HTTP only in development
PASSKEY_RP_NAME=Rusty Feed               # 1..64 printable characters
# Optional bundled Caddy profiles: https-auto or https-custom (choose one).
# RUSTY_FEED_DOMAIN=reader.example.com
# TLS_EMAIL=admin@example.com          # automatic ACME/Let's Encrypt profile
# TLS_CERT_DIR=../certs                # custom profile host directory
# TLS_CERT_FILE=cert.pem
# TLS_KEY_FILE=key.pem

# ── Database (required) ──────────────────────────────────────────────────────
# Host port published by Docker Compose. Keep DATABASE_URL's port in sync when
# running Rusty Feed or database tools directly on the host.
POSTGRES_PORT=5432
POSTGRES_USER=rusty_feed
POSTGRES_PASSWORD=rusty_feed
POSTGRES_DB=rusty_feed
DATABASE_URL=postgres://rusty_feed:rusty_feed@localhost:5432/rusty_feed
AUTO_MIGRATE=true              # Compose entrypoint applies migrations before boot

# ── Cache / Redis ────────────────────────────────────────────────────────────
# Redis is optional. Set CACHE_ENABLED=false and omit REDIS_URL for the
# in-process L1 cache only.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=
CACHE_ENABLED=true
CACHE_NAMESPACE=rusty-feed           # isolate L2 keys/pub-sub when Redis is shared

# ── Auth & sessions (required secrets) ───────────────────────────────────────
# Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-32-bytes-min
REGISTRATION_MODE=open         # open | invite | closed; first user becomes admin
# Trusted reverse-proxy identity is disabled unless all trust boundaries are explicit.
REVERSE_PROXY_AUTH_ENABLED=false
REVERSE_PROXY_AUTH_TRUSTED_CIDRS=127.0.0.1/32,::1/128
REVERSE_PROXY_AUTH_USER_HEADER=x-remote-user
REVERSE_PROXY_AUTH_NAME_HEADER=x-remote-name
REVERSE_PROXY_AUTH_AUTO_PROVISION=true
# REVERSE_PROXY_AUTH_ALLOWED_DOMAINS=example.com,company.example
# REVERSE_PROXY_AUTH_ADMIN_EMAILS=admin@example.com
# REVERSE_PROXY_AUTH_LOGOUT_URL=https://auth.example.com/logout
# OAuth (optional; local accounts work without any of these)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_AUTH_URL=
# OAUTH_TOKEN_URL=
# OAUTH_USERINFO_URL=
# OAUTH_PROVIDER_NAME=OAuth

# ── Secrets encryption (required) ────────────────────────────────────────────
# Master secret for encrypted stored-secret paths. Public page extraction never uses feed cookies. Generate with: openssl rand -base64 48
ENCRYPTION_SECRET=change-me-32-bytes-min

# ── Embeddings (one model per instance) ──────────────────────────────────────
# Master switch for every embedding use case: semantic/hybrid search, the
# auto-embedding background job, and saved-search semantic ranking. Set to
# false to skip loading/downloading a model entirely (no ONNX runtime, no
# OpenAI credential requirement) and run everything keyword-only — forces
# SEARCH_MODE=keyword and EMBEDDING_AUTO_GENERATE=false regardless of the
# values below. Saved searches keep working via keyword-only matching.
EMBEDDINGS_ENABLED=true
# `local` uses the production BGE fastembed model cached in MODEL_CACHE_DIR;
# `openai` selects a compatible remote embedding endpoint instead.
EMBEDDING_PROVIDER=local       # local | openai
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5 # fixed per instance; changing it requires re-embed
EMBEDDING_BATCH_SIZE=10
EMBEDDING_AUTO_GENERATE=false
MODEL_CACHE_DIR=/var/lib/rusty-feed/models
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # root URL also accepted

# ── Search ──────────────────────────────────────────────────────────────────────
# Users may inherit or override these defaults in Reading preferences.
# Ignored (forced to keyword) when EMBEDDINGS_ENABLED=false.
SEARCH_MODE=hybrid                         # hybrid | keyword | semantic
SEARCH_TEXT_CONFIG=simple                  # simple (multilingual) | english (stemming)
SEARCH_SEMANTIC_WEIGHT_PERCENT=60          # 0..100, contribution in hybrid mode

# ── LLM (summarization; optional) ────────────────────────────────────────────
LLM_PROVIDER=openai            # openai | ollama
LLM_SUMMARY_MODEL=gpt-4o-mini
LLM_DIGEST_MODEL=gpt-4o-mini
LLM_AUTO_SUMMARIZE=false                       # shared background summaries; may incur cost
OLLAMA_BASE_URL=http://localhost:11434

# ── Content extraction ───────────────────────────────────────────────────────
CHROMIUM_ENABLED=true
CHROMIUM_PORT=9222
CHROMIUM_CDP_URL=http://localhost:9222   # remote headless Chrome (compose service)
EXTRACTION_TIMEOUT_MS=30000
EXTRACTION_DELAY_MS=3000        # per-domain base delay
# When true (default), feed ingest pre-extracts public article pages for
# article-page subscribers in the background. Set false to extract lazily on the
# first reader access instead (using the interactive priority lane) — this cuts
# background work and Chromium usage at the cost of a short wait on first open.
ARTICLE_PAGE_EAGER_EXTRACTION=true
RESPECT_ROBOTS_TXT=true
OUTBOUND_USER_AGENT="Rusty-Feed/0.1 (+https://github.com/madpin/rusty-feed)" # 1..256 printable ASCII chars
OUTBOUND_HTTP1_ONLY=false       # true disables HTTP/2 for every publisher request
# SSRF guard: reject feeds/content on private/loopback addresses. Leave false in
# production; set true only for trusted intranet feeds or local testing.
FEEDS_ALLOW_PRIVATE_NETWORK=false

# Remove known analytics query parameters from shared article keys, publisher
# fetches, and rendered content links. Extra entries are exact names or a
# trailing-wildcard prefix; domain exceptions include all subdomains.
TRACKING_URL_CLEANUP_ENABLED=true
TRACKING_URL_EXTRA_PARAMETERS=          # e.g. campaign_id,ref_*
TRACKING_URL_DOMAIN_EXCEPTIONS=         # e.g. signed.example.com,legacy.example.org

# Tracking images are removed locally during shared content processing; no
# remote image probe is made. Allowed hosts override URL/host rules, but never
# explicit tiny or hidden-image detection. Lists accept at most 100 hostnames.
TRACKING_PIXEL_STRICTNESS=balanced       # conservative | balanced | strict
TRACKING_PIXEL_BLOCKED_HOSTS=            # e.g. metrics.example.com,pixels.example.org
TRACKING_PIXEL_ALLOWED_HOSTS=            # e.g. images.metrics.example.com

# Privacy-enhanced YouTube players. Source hosts are validated and bounded;
# the built-in embed uses youtube-nocookie.com and an optional alternative must
# be one administrator-approved credential-free HTTPS origin.
YOUTUBE_EMBEDS_ENABLED=true
YOUTUBE_SOURCE_HOSTS=                    # empty uses youtube.com,youtube-nocookie.com,youtu.be
# Optional Invidious-compatible HTTPS player; configure both values together.
YOUTUBE_ALTERNATIVE_PLAYER_NAME=
YOUTUBE_ALTERNATIVE_PLAYER_URL=
YOUTUBE_DURATION_ENABLED=false             # shared public-page duration enrichment
YOUTUBE_DURATION_DAILY_BUDGET=100           # 1..10000 shared attempts/day
YOUTUBE_DURATION_CACHE_DAYS=30              # 1..365 days

# Shared, article-authorized media proxy. Successful bodies are stored once per
# source URL; values are bounded both per object and across the instance.
MEDIA_PROXY_ENABLED=true
MEDIA_PROXY_MAX_BYTES=67108864                 # 64 MiB per attachment
MEDIA_PROXY_CACHE_BUDGET_BYTES=2147483648      # 2 GiB aggregate body budget
MEDIA_PROXY_CACHE_TTL_SECONDS=604800            # 7 days
MEDIA_PROXY_NEGATIVE_TTL_SECONDS=300            # retry publisher failures after 5 minutes
MEDIA_PROXY_EXTRA_INLINE_MIME_TYPES=             # optional: image/jxl,image/heic,image/heif,audio/3gpp,audio/3gpp2,audio/x-m4a,video/3gpp,video/3gpp2,video/x-m4v

# Shared article rows: 0 keeps them forever. Bookmarks are always preserved.
# Public launch (§10.3): set a FINITE value (e.g. 90) so open ingest doesn't grow
# the shared articles/embeddings tables without bound; monitor DB size.
ARTICLE_RETENTION_DAYS=0
RETENTION_AGE_BASIS=published                   # published | created

# ── Background jobs / AGENTS ──────────────────────────────────────────────────
ENABLE_CRON_JOBS=true           # false keeps queue consumers but disables scheduled work
RUN_EMBEDDED_WORKER=true        # run the AGENTS worker inside the server process
# The scheduler evaluates these UTC cron expressions and still respects each
# feed's persisted health-adjusted next-fetch time.
FEED_REFRESH_SCHEDULE=*/5 * * * *
CLEANUP_SCHEDULE=0 3 * * *
# Background queue slots shared by feed refresh, extraction, embedding, and
# summarization. This work is network-bound (it mostly waits on remote hosts and
# LLM APIs), so more slots than CPU cores is expected. Raise it if extraction or
# LLM summaries back up; lower it if local embeddings saturate the CPU.
FEED_REFRESH_CONCURRENCY=6
# Reserved low-latency slots for user-triggered work (on-demand extraction and
# summaries). Bump this on busy multi-user instances.
INTERACTIVE_JOB_CONCURRENCY=2
SAVED_SEARCH_CONCURRENCY=5      # reserved for per-agent worker pools
JOB_LOCK_TIMEOUT_MS=600000      # reserved for configurable job leases

# ── Public launch: AI cost & compute budgets (docs/PUBLIC_LAUNCH_PLAN.md §4.1) ─
# 0 / 0.0 == unlimited (the historical single-tenant default). On a public,
# open-registration instance set finite values so strangers cannot drain your
# wallet or CPU. Users with their own enabled API key (Settings → AI) are exempt
# from the USD budgets; the per-user call caps apply to everyone.
AI_LLM_GLOBAL_DAILY_USD=0            # e.g. 5.00 — instance-wide daily kill-switch
AI_LLM_PER_USER_DAILY_USD=0          # e.g. 0.10 — per-user instance-funded cap
AI_LLM_PER_USER_DAILY_CALLS=0        # e.g. 25 — per-user summary calls/day
AI_EMBED_PER_USER_DAILY_CALLS=0      # e.g. 500 — per-user search embeds/day

# ── Public launch: feed ingest fan-out caps (§4.3; 0 == unlimited) ─────────────
FEED_MAX_ITEMS_PER_REFRESH=0         # e.g. 200 — newest-first cap per refresh
FEED_MAX_ARTICLES=0                  # e.g. 5000 — advisory; trimmed by retention

# ── Public launch: trusted reverse-proxy IPs (§4.4) ───────────────────────────
# Only requests whose socket peer is inside one of these CIDRs may set the client
# IP via X-Forwarded-For / X-Real-IP; otherwise the socket peer is used. This
# stops header spoofing from defeating the IP rate limits below.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# ── Public launch: rate limits (requests/min per key; 0 == unlimited) (§4.4) ──
RATE_LIMIT_AUTH_PER_MIN=10           # login/register/OAuth/ClientLogin per IP
RATE_LIMIT_API_PER_MIN=600           # native API + Fever + GReader per token
RATE_LIMIT_FEED_ADD_PER_MIN=60       # feed subscribe/discovery per user
RATE_LIMIT_SEARCH_PER_MIN=120        # search per user
RATE_LIMIT_SUMMARIZE_PER_MIN=20      # on-demand AI summaries per user
RATE_LIMIT_OPML_PER_MIN=10           # OPML import/preview per user
RATE_LIMIT_MEDIA_PER_MIN=1800        # media proxy per user

# ── Public launch: per-user quotas (§4.2; 0 == unlimited) ─────────────────────
# Count per-user rows only (shared content is never affected). Suggested public
# values shown in comments; default 0 keeps the historical single-tenant behavior.
QUOTA_MAX_SUBSCRIPTIONS=0            # e.g. 250
QUOTA_MAX_SAVED_SEARCHES=0          # e.g. 25
QUOTA_MAX_CATEGORIES=0              # e.g. 100
QUOTA_MAX_API_TOKENS=0             # e.g. 10
QUOTA_MAX_INTEGRATIONS=0          # e.g. 10
QUOTA_MAX_PUBLIC_SHARES=0        # e.g. 100

# ── Public launch: signup anti-abuse (§4.5) ───────────────────────────────────
# Email verification requires SMTP. Local accounts start unverified and cannot
# add feeds / summarize until they confirm; OAuth accounts are trusted. An SMTP
# outage never breaks signup (the mailer degrades to a no-op).
EMAIL_VERIFICATION_REQUIRED=false
# SMTP_URL=smtps://user:pass@smtp.example.com:465   # or smtp://host:587 (STARTTLS)
# SMTP_FROM=Rusty Feed <no-reply@example.com>
MIN_PASSWORD_LENGTH=10               # 4..1024
LOGIN_MAX_FAILURES=10                # per-account lock threshold (0 disables)
LOGIN_LOCKOUT_SECONDS=900            # lock duration after too many failures
# CAPTCHA on registration (Cloudflare Turnstile or hCaptcha). Empty disables it.
# CAPTCHA_PROVIDER=turnstile          # turnstile | hcaptcha
# CAPTCHA_SITE_KEY=
# CAPTCHA_SECRET=

# ── Public launch: legal & compliance (§9) ────────────────────────────────────
# Static Terms/Privacy/Acceptable-Use/Abuse pages live at /terms /privacy
# /acceptable-use /abuse and are linked in the footer. Review them for your
# jurisdiction. Self-serve export/delete live at /settings/account.
# LEGAL_CONTACT_EMAIL=abuse@example.com   # shown on the Abuse/DMCA + Privacy pages
# LEGAL_ENTITY_NAME=Example Media          # operator name in the legal pages
REQUIRE_TOS_ACCEPTANCE=false               # require a Terms/Privacy checkbox at signup

# ── Public launch: demo mode (§7) ─────────────────────────────────────────────
# A shared guest sandbox on the same instance: "Try the demo" provisions
# ephemeral accounts preloaded with the featured catalog feeds, organized into
# folders/tags by topic, then wiped daily. Featured feeds are never automatically
# added to regular accounts. Demo accounts are sandboxed (no summaries, BYO-key,
# integrations, shares, tokens, or arbitrary feed adds) and get a tighter
# subscription cap. The reset only ever deletes is_demo users. Also exposes a
# read-only admin demo ("see as admin").
DEMO_MODE=false
DEMO_RESET_SCHEDULE=0 4 * * *               # UTC cron for the daily wipe
DEMO_MAX_SUBSCRIPTIONS=20                    # tighter cap for demo accounts
DEMO_ADMIN_READONLY=true                     # expose the read-only admin demo
DEMO_SESSION_TTL_HOURS=24                    # demo session lifetime (< the daily reset)
